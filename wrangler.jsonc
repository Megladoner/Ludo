{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parcheesi",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_HUB", "class_name": "RoomHub" },
      { "name": "CHESS_HUB", "class_name": "ChessHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ChessHub"] }
  ],
  "observability": { "enabled": true }
}
